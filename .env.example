# --- SUMOPOD LLM API (required) ---
SUMOPOD_API_KEY=your_api_key_here
SUMOPOD_MODEL=your_model_name
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1

# --- Optional: sensible defaults exist for all of these ---
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
# json_mode (default, works with reasoning models) or function_calling
LLM_STRUCTURED_MODE=json_mode
MAX_INPUT_CHARS=4000
LOG_ENABLED=true
